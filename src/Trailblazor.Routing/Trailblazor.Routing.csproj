<Project Sdk="Microsoft.NET.Sdk.Razor">

	<Import Project="..\..\Global.props" />

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnablePackageValidation>true</EnablePackageValidation>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Authors>Nicolai Wolf</Authors>
		<Description>Flexible and configurable routing framework for Blazor applications.</Description>
		<RepositoryUrl>https://github.com/Nico1395/trailblazor-routing</RepositoryUrl>
		<PackageTags>Blazor;Routing</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<!-- Project References -->
	<PropertyGroup>
		<HolonComCoreReferenceType Condition="'$(HolonComCoreReferenceType)' == ''">source</HolonComCoreReferenceType>
	</PropertyGroup>

	<ItemGroup Condition="'$(HolonComCoreReferenceType)' == 'source'">
	</ItemGroup>
	<ItemGroup Condition="'$(HolonComCoreReferenceType)' == 'nuget'">
	</ItemGroup>
	
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.1" />
  </ItemGroup>
</Project>